description: "Make tests deterministic, contract-focused, failure-sensitive, and maintainable."
globs: "**/{test,tests,spec,specs,__tests__}/**,**/*.{test,spec}.{js,jsx,ts,tsx},**/test_*.py,**/*_test.{py,go,rs,c,cc,cpp}"
alwaysApply: false
